<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- UpgradeCode is permanent. Do not change it between releases. -->
  <Package
    Name="Border Studio"
    Manufacturer="TEW020"
    Version="$(var.Version)"
    UpgradeCode="b55bc979-12a4-4eb7-bc76-bf7e80d1cdee"
    Scope="perUser"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Border Studio is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="assets\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Border Studio" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="App" Title="Border Studio" Description="Border Studio application files" Level="1" AllowAbsent="no" Display="expand">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.payload)\borderstudio.exe" />
    </Feature>

    <Feature Id="StartMenuShortcut" Title="Start Menu shortcut" Description="Add Border Studio to the Start Menu" Level="1" AllowAbsent="yes" AllowAdvertise="no">
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Guid="*">
        <Shortcut
          Id="AppShortcut"
          Name="Border Studio"
          Description="Border Studio"
          Target="[INSTALLFOLDER]borderstudio.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\TEW020\BorderStudio" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Description="Add Border Studio to the Desktop" Level="2" AllowAbsent="yes" AllowAdvertise="no">
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
        <Shortcut
          Id="DesktopAppShortcut"
          Name="Border Studio"
          Description="Border Studio"
          Target="[INSTALLFOLDER]borderstudio.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon"
          Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\TEW020\BorderStudio" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="packaging\license.rtf" />
  </Package>
</Wix>
